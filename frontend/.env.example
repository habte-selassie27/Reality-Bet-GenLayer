# Deployed RealityBet contract (GenLayer Studio network)
VITE_CONTRACT_ADDRESS=0xAe0D8d3a9e8E15816571308B65f9Ddd4B925F4b5
# studionet | testnetAsimov | testnetBradbury | localnet
VITE_NETWORK=studionet
# Optional: leave empty to use the same-origin /api/rpc proxy (recommended).
# Set an absolute URL for a dedicated RPC endpoint, or the literal "direct" to
# bypass the proxy and call Studio from the browser.
VITE_RPC_URL=
# Optional: extra market ids to pin in this browser's registry. The contract is
# enumerable now (get_market_ids / get_markets_page), so this is no longer needed.
VITE_SEED_MARKETS=
